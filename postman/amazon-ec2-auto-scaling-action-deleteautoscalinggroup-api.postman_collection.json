      "item": [
        {
          "name": "Amazon EC2 Auto Scaling GET_ Delete Auto Scaling Group",
          "id": "736064f5-6ef9-46d8-a431-8b8820ee5b71",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
