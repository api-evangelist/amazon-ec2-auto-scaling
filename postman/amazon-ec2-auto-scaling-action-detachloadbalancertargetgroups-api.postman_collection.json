                  "description": "(Required) The name of the Auto Scaling group.",
                  "key": "AutoScalingGroupName",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The Amazon Resource Names (ARN) of the target groups. You can specify up to 10 target groups.",
                  "key": "TargetGroupARNs",
