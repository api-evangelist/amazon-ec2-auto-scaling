      "name": "#Action=RollbackInstanceRefresh",
      "item": [
        {
          "name": "Amazon EC2 Auto Scaling GET_ Rollback Instance Refresh",
          "id": "9667dacf-26f1-4bd4-a785-6df53df5d166",
